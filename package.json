{
  "name": "cyberfiles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --strictPort --host=0.0.0.0",
    "dev:desktop": "tauri dev",
    "build": "vite build",
    "build:desktop": "tauri build --debug --no-bundle",
    "preview": "vite preview",
    "clean": "node -e \"for (const path of ['dist','server.js']) { require('fs').rmSync(path, { recursive: true, force: true }); }\"",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/utils/fileSystem.test.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
