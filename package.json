{
  "name": "cyberfiles",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:desktop": "tauri dev",
    "dev:vite-internal": "vite --port=3001 --strictPort --host=127.0.0.1",
    "build": "vite build",
    "build:desktop": "tauri build --debug --no-bundle",
    "clean": "node -e \"for (const path of ['dist']) { require('fs').rmSync(path, { recursive: true, force: true }); }\"",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/utils/fileSystem.test.ts src/utils/folderStylePreferences.test.ts src/utils/mouseGesture.test.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:installer": "tauri build --bundles nsis",
    "build:portable": "tauri build --no-bundle && npm run package:portable",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
