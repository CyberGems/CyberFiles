{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberFiles",
  "version": "0.6.0",
  "identifier": "com.cybergems.cyberfiles",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberFiles",
        "decorations": false,
        "width": 1200,
        "height": 760,
        "minWidth": 500,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "tray_menu",
        "title": "CyberFiles Tray Menu",
        "url": "tray.html",
        "width": 292,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "CyberGems",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer.nsh",
        "displayLanguageSelector": false,
        "sidebarImage": "icons/installerSidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Spanish"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/CyberGems/CyberFiles/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNUM4RTM3NzVGRjcxQzkKUldUSmNmOTFONDVjZ3MvMU1RaU5nZ0s0VEhpcldlK1BpQy9xQzlHNHFwMllGZFdMUitKUVdCRTkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
