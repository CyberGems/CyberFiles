{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberFiles",
  "version": "0.4.0",
  "identifier": "com.cybergems.cyberfiles",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberFiles",
        "decorations": false,
        "width": 1200,
        "height": 760,
        "minWidth": 500,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "tray_menu",
        "title": "CyberFiles Tray Menu",
        "url": "tray.html",
        "width": 292,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CyberGems",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
