<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CyberFiles.WinUIPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CyberFiles.WinUIPrototype"
    Title="CyberFiles · Native Explorer (prototype)">
    <Grid Padding="14" Background="#101113" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10" CornerRadius="10" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#30D7E9" />
                    <TextBlock x:Name="AppTitle" Text="CyberFiles" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PrototypeLabel" Text="WinUI · prototipo" Foreground="#A8ABB2" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ActivePaneText" Grid.Column="1" Text="Panel activo: izquierdo" Foreground="#91EAF4" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Button x:Name="ActivityCenterToggleButton" Grid.Column="2" Click="ActivityCenterToggle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#30D7E9" />
                        <TextBlock x:Name="ActivityCenterButtonLabel" Text="Operaciones" />
                        <Border x:Name="ActivityBadge" Padding="6,1" CornerRadius="9" Background="#123D48" BorderBrush="#1F6877" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="ActivityBadgeText" Text="0" FontSize="11" Foreground="#91EAF4" />
                        </Border>
                    </StackPanel>
                </Button>
                <ComboBox x:Name="LanguageBox" Grid.Column="3" Width="116" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Español" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LeftPaneHeader" Text="PANEL IZQUIERDO" Foreground="#91EAF4" FontSize="12" FontWeight="SemiBold" Margin="3,0" VerticalAlignment="Center" />
                    <Button x:Name="LeftCopyButton" Grid.Column="1" Content="Copiar →" Click="LeftCopy_Click" IsEnabled="False" />
                    <Button x:Name="LeftMoveButton" Grid.Column="2" Content="Mover →" Click="LeftMove_Click" IsEnabled="False" />
                </Grid>
                <local:FilePaneView x:Name="LeftPane" Grid.Row="1" />
            </Grid>
            <Border Grid.Column="1" Width="1" Margin="0,24,0,0" Background="#30343A" />
            <Grid Grid.Column="2" RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RightCopyButton" Content="← Copiar" Click="RightCopy_Click" IsEnabled="False" />
                    <Button x:Name="RightMoveButton" Grid.Column="1" Content="← Mover" Click="RightMove_Click" IsEnabled="False" />
                    <TextBlock x:Name="RightPaneHeader" Grid.Column="2" Text="PANEL DERECHO" Foreground="#A8ABB2" FontSize="12" FontWeight="SemiBold" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <local:FilePaneView x:Name="RightPane" Grid.Row="1" />
            </Grid>
        </Grid>

        <Border
            x:Name="ActivityCenterPanel"
            Grid.Row="1"
            Width="680"
            Height="520"
            MaxHeight="540"
            Margin="0,0,16,12"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#191B1F"
            BorderBrush="#454A52"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ActivityCenterTranslation" Y="22" />
            </Border.RenderTransform>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="#0D3038" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#30D7E9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ActivityCenterTitle" Text="Centro de operaciones" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ActivityCenterSummary" Text="Sin operaciones pendientes" Foreground="#A8ABB2" />
                    </StackPanel>
                    <ToggleButton x:Name="ActivityPinButton" Grid.Column="2" Content="Fijar" Click="ActivityPin_Click" VerticalAlignment="Center" />
                    <Button x:Name="ActivityCenterCloseButton" Grid.Column="3" Content="×" Width="38" Click="ActivityCenterClose_Click" VerticalAlignment="Center" />
                </Grid>

                <Grid x:Name="ActivityQueueSection" Grid.Row="1" RowSpacing="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActivityQueueHeading" Text="EN CURSO Y EN COLA" Foreground="#A8ABB2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="ActivityAggregateProgress" Grid.Column="1" Height="4" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" />
                        <Button x:Name="ActivityCancelCurrentButton" Grid.Column="2" Content="Cancelar actual" Click="CancelOperation_Click" Visibility="Collapsed" />
                        <Button x:Name="ActivityCancelQueueButton" Grid.Column="3" Content="Cancelar todo" Click="CancelQueue_Click" Visibility="Collapsed" />
                    </Grid>
                    <ListView
                        x:Name="ActivityQueueList"
                        Grid.Row="1"
                        MaxHeight="190"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,5" CornerRadius="8" Background="#111315" BorderBrush="#30343A" BorderThickness="1">
                                    <Grid RowSpacing="5" ColumnSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#91EAF4" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Route}" Foreground="#A8ABB2" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding ProgressVisibility}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActivityRecentHeading" Text="RECIENTES" Foreground="#A8ABB2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="ActivityHistoryClearButton" Grid.Column="1" Content="Limpiar recientes" Click="ActivityHistoryClear_Click" VerticalAlignment="Center" />
                </Grid>
                <ListView
                    x:Name="ActivityHistoryList"
                    Grid.Row="3"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,5" CornerRadius="8" Background="#111315" BorderBrush="#30343A" BorderThickness="1">
                                <Grid ColumnSpacing="10" RowSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Route}" Foreground="#A8ABB2" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="ActivityEmptyText"
                    Grid.Row="3"
                    Text="Aún no hay operaciones recientes."
                    Foreground="#858A93"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12,8" CornerRadius="8" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PrototypeStatus" Text="Navegación independiente en ambos paneles" Foreground="#A8ABB2" VerticalAlignment="Center" />
                    <TextBlock x:Name="OperationStatus" Grid.Column="1" Text="" Foreground="#91EAF4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600" />
            </Grid>
        </Border>
    </Grid>
</Window>
