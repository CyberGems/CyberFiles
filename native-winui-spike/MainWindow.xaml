<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CyberFiles.WinUIPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CyberFiles.WinUIPrototype"
    Title="CyberFiles · Native Explorer (prototype)">
    <Grid Padding="14" Background="#101113" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10" CornerRadius="10" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#30D7E9" />
                    <TextBlock x:Name="AppTitle" Text="CyberFiles" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PrototypeLabel" Text="WinUI · prototipo" Foreground="#A8ABB2" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ActivePaneText" Grid.Column="1" Text="Panel activo: izquierdo" Foreground="#91EAF4" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="116" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Español" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LeftPaneHeader" Grid.Row="0" Text="PANEL IZQUIERDO" Foreground="#91EAF4" FontSize="12" FontWeight="SemiBold" Margin="3,0" />
                <local:FilePaneView x:Name="LeftPane" Grid.Row="1" />
            </Grid>
            <Border Grid.Column="1" Width="1" Margin="0,24,0,0" Background="#30343A" />
            <Grid Grid.Column="2" RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RightPaneHeader" Grid.Row="0" Text="PANEL DERECHO" Foreground="#A8ABB2" FontSize="12" FontWeight="SemiBold" Margin="3,0" />
                <local:FilePaneView x:Name="RightPane" Grid.Row="1" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,8" CornerRadius="8" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <TextBlock x:Name="PrototypeStatus" Text="Navegación independiente en ambos paneles" Foreground="#A8ABB2" />
        </Border>
    </Grid>
</Window>
