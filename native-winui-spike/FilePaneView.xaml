<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CyberFiles.WinUIPrototype.FilePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CyberFiles.WinUIPrototype">
    <Grid RowSpacing="8" GotFocus="Pane_GotFocus" PointerPressed="Pane_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="9" CornerRadius="8" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Width="38" Content="←" Click="Back_Click" />
                <Button x:Name="UpButton" Grid.Column="1" Width="38" Content="↑" Click="Up_Click" />
                <Button x:Name="RefreshButton" Grid.Column="2" Width="82" Content="Actualizar" Click="Refresh_Click" />
                <TextBox x:Name="PathBox" Grid.Column="3" VerticalAlignment="Center" PlaceholderText="Escribe o pega una ruta..." KeyDown="PathBox_KeyDown" />
                <Button x:Name="OpenButton" Grid.Column="4" Content="Abrir" Click="Open_Click" />
                <Button x:Name="CancelButton" Grid.Column="5" Content="Cancelar" Click="Cancel_Click" IsEnabled="False" />
                <ComboBox x:Name="SortBox" Grid.Column="6" Width="164" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="9" CornerRadius="8" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" PlaceholderText="Filtrar por nombre..." TextChanged="FilterBox_TextChanged" />
                <Button x:Name="NewFolderButton" Grid.Column="1" Content="Nueva carpeta" Click="NewFolder_Click" />
                <Button x:Name="RenameButton" Grid.Column="2" Content="Renombrar" Click="Rename_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Grid.Column="3" Content="Papelera" Click="Delete_Click" IsEnabled="False" />
            </Grid>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" Background="#151619" BorderBrush="#30343A" BorderThickness="1">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,0" Background="#1C1E22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NameHeader" Grid.Column="1" Text="NOMBRE" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#91EAF4" />
                        <TextBlock x:Name="TypeHeader" Grid.Column="2" Text="TIPO" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A8ABB2" />
                        <TextBlock x:Name="SizeHeader" Grid.Column="3" Text="TAMAÑO" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#A8ABB2" />
                        <TextBlock x:Name="ModifiedHeader" Grid.Column="4" Text="MODIFICADO" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#A8ABB2" />
                    </Grid>
                </Border>

                <ListView
                    x:Name="EntryList"
                    Grid.Row="1"
                    Loaded="EntryList_Loaded"
                    SelectionMode="Extended"
                    IncrementalLoadingTrigger="Edge"
                    IncrementalLoadingThreshold="3"
                    IsItemClickEnabled="False"
                    DoubleTapped="EntryList_DoubleTapped"
                    KeyDown="EntryList_KeyDown"
                    SelectionChanged="EntryList_SelectionChanged"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileRowDisplay">
                            <Border Padding="10,0">
                                <Grid MinHeight="38" ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="#A8ABB2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#BFC3CA" />
                                    <TextBlock Grid.Column="4" Text="{Binding Modified}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#A8ABB2" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="10,8" CornerRadius="8" Background="#191B1F" BorderBrush="#30343A" BorderThickness="1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Listo" Foreground="#A8ABB2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CountText" Grid.Column="1" Text="0 elementos" Foreground="#E3E5E8" VerticalAlignment="Center" />
                <TextBlock x:Name="SelectionText" Grid.Column="2" Text="0 seleccionados" Foreground="#91EAF4" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
